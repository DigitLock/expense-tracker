DB_HOST=postgres
DB_PORT=5432
DB_USER=expense_staging
DB_PASSWORD=
DB_NAME=expense_tracker_staging
DB_SSLMODE=disable
SERVER_PORT=8080
GRPC_PORT=50051
# Required. The server refuses to start without it (only APP_ENV=dev allows
# an insecure fallback; never set APP_ENV=dev here). Generate e.g. with
# `openssl rand -base64 48`.
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
CORS_ALLOWED_ORIGINS=
# Currency Rate Service address; empty on staging = no live rates (fallback).
CURRENCY_SERVICE_ADDR=
CURRENCY_SYNC_INTERVAL=6h
CURRENCY_SYNC_TIMEOUT=10s
